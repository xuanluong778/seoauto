# =============================================================================
# SEOAuto — example environment only
# Copy to env.local (or export in process manager). NEVER commit real secrets.
# All values below are FICTIONAL placeholders for local/dev documentation.
# =============================================================================

# --- Core ---
APP_ENV=development
BENCH_FAST=0
SEOAUTO_PRODUCTION=0
APP_BASE_URL=http://127.0.0.1:8899
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8899
DATABASE_URL=postgresql+psycopg2://seoauto_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/seoauto
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
ADMIN_EMAIL=admin@example.com

# --- SMTP / OTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=SEOAuto
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=300
OTP_EMAIL_SUBJECT=Your SEOAuto login code

# --- Chatbot CSKH inbox email (Resend, server-side only — never expose to frontend) ---
RESEND_API_KEY=re_CHANGE_ME_RESEND_API_KEY
RESEND_FROM_EMAIL=SEOAuto <noreply@example.com>
CHATBOT_NOTIFY_DELAY_SECONDS=120
CHATBOT_NOTIFY_COOLDOWN_SECONDS=900

# --- Google OAuth / APIs ---
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8899/api/integrations/google/callback
BLOGGER_REDIRECT_URI=http://127.0.0.1:8899/api/integrations/blogger/callback
GOOGLE_CSE_API_KEY=CHANGE_ME_GOOGLE_CSE_API_KEY
GOOGLE_CSE_ID=CHANGEME_cse_id
GOOGLE_PLACES_API_KEY=CHANGE_ME_GOOGLE_PLACES_API_KEY

# --- Media / LLM ---
PEXELS_API_KEY=CHANGE_ME_PEXELS_API_KEY
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-CHANGE_ME_OPENAI_API_KEY_PLACEHOLDER
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
LLM_TEMPERATURE=0.4
CONTENT_AI_LLM_MODE=auto

# --- SERP ---
SERP_DEFAULT_COUNTRY=vn
SERP_DEFAULT_LANGUAGE=vi
SERP_DEFAULT_DEVICE=desktop
SERP_FETCH_ENABLED=0
SERP_FETCH_PROVIDER_ORDER=dataforseo
SERP_TOP_N=10
SERP_FETCH_CONCURRENCY=2
SERP_FETCH_RETRIES=2
SERP_MIN_VALID_RESULTS=3
SERP_BACKFILL_MAX_PAGES=2
SERP_TITLE_SIMILARITY_THRESHOLD=0.55
SERP_SNAPSHOT_DISK=1
SERP_CACHE_TTL_SECONDS=86400
SERP_MEMORY_CACHE_MAX=256

# --- DataForSEO / volume ---
VOLUME_API_ENABLED=0
VOLUME_BATCH_SIZE=100
VOLUME_CACHE_TTL_SECONDS=604800
VOLUME_DB_LOOKUP_CHUNK=500
DATAFORSEO_BASE_URL=https://api.dataforseo.com
DATAFORSEO_LOGIN=user@example.com
DATAFORSEO_PASSWORD=CHANGE_ME_DATAFORSEO_PASSWORD
DATAFORSEO_LOCATION_CODE=2704
DATAFORSEO_LANGUAGE_CODE=vi
DATAFORSEO_ENABLED=0

# --- Google Ads API (Keyword Research primary; never commit real secrets) ---
GOOGLE_ADS_KEYWORD_ENABLED=1
GOOGLE_ADS_DEVELOPER_TOKEN=CHANGE_ME_GOOGLE_ADS_DEVELOPER_TOKEN
GOOGLE_ADS_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=CHANGE_ME_GOOGLE_ADS_CLIENT_SECRET
GOOGLE_ADS_REFRESH_TOKEN=CHANGE_ME_GOOGLE_ADS_REFRESH_TOKEN
GOOGLE_ADS_LOGIN_CUSTOMER_ID=0000000000
GOOGLE_ADS_CUSTOMER_ID=0000000000
GOOGLE_ADS_GEO_TARGET_ID=2704
GOOGLE_ADS_LANGUAGE_ID=1040
GOOGLE_ADS_TIMEOUT_SECONDS=30
GOOGLE_ADS_RETRY_MAX=3

# --- Keyword research knobs (non-secret) ---
KEYWORD_RESEARCH_EXPAND_PROVIDER=google_ads
KEYWORD_CLUSTER_SERP_CONFIDENCE_MIN=0.55
KEYWORD_CLUSTER_SERP_MAX_KEYWORDS=40
KEYWORD_RESEARCH_DATAFORSEO_K4K_LIMIT=50
KEYWORD_RESEARCH_DATAFORSEO_K4K_TOTAL=200
KEYWORD_RESEARCH_K4K_CACHE_TTL=86400
KEYWORD_RESEARCH_RUN_CLUSTER_MODE=async
KEYWORD_RESEARCH_SERP_CLUSTER_INTENT=1
KEYWORD_RESEARCH_CLUSTER_MAX=100
KEYWORD_RESEARCH_SERP_EXPAND=0
KEYWORD_RESEARCH_EXPAND=1
KEYWORD_RESEARCH_FETCH_SERP_TOP10=0
KEYWORD_RESEARCH_SERP_TOP10_MAX=10
KEYWORD_RESEARCH_SERP_TOP10_WORKERS=2
KEYWORD_RESEARCH_FETCH_SEED_KD=0
KEYWORD_RESEARCH_FETCH_SERP_CLUSTER=0
KEYWORD_RESEARCH_SERP_INTENT_WORKERS=2
KEYWORD_CLUSTER_SERP_JACCARD_THRESHOLD=0.5
KEYWORD_CLUSTER_SERP_URL_FANOUT_CAP=20
CLUSTER_INTENT_DOMINANCE_MIN=0.45
KEYWORD_CLUSTER_INLINE=0

# --- Credits / SaaS ---
CREDITS_ENABLED=1
SIGNUP_CREDIT_BONUS=0
CREDIT_COST_RESEARCH_RUN=1
CREDIT_COST_VOLUME_PER_KEYWORD=1
CREDIT_VOLUME_BATCH_MAX_CHARGE=100
CREDIT_COST_CLUSTER_SYNC=1
CREDIT_COST_CLUSTER_ASYNC=1
CREDIT_COST_CLUSTER_SAVE=1
CREDIT_COST_IMPORT_EXCEL=1
CREDIT_COST_ANALYZE_PROJECT=10
CREDIT_COST_TECHNICAL_ANALYZE=5
CREDIT_COST_URL_SEO_SCOREBOARD=1
SAAS_ENFORCEMENT=1
COST_CONTROL_ENABLED=1
BILLING_VAT_PERCENT=10

# --- SePay / bank presentation (sample public bank fields) ---
SEPAY_WEBHOOK_SECRET=CHANGE_ME_SEPAY_WEBHOOK_SECRET
SEPAY_API_KEY=CHANGE_ME_SEPAY_API_KEY
# Default require auth=1; production always enforces auth (cannot disable).
# Non-production only: SEPAY_WEBHOOK_REQUIRE_AUTH=0 for local unsigned tests.
SEPAY_WEBHOOK_REQUIRE_AUTH=1
BILLING_BANK_CODE=ACB
BILLING_BANK_ACCOUNT=0000000000
BILLING_BANK_HOLDER=Example Company LLC
PAYMENT_ORDER_EXPIRE_MINUTES=60
PAYMENT_QR_ENABLED=1

# --- Internal tokens ---
INTERNAL_CRON_TOKEN=CHANGE_ME_INTERNAL_CRON_TOKEN_RANDOM_48
WEB20_INTERNAL_TOKEN=CHANGE_ME_WEB20_INTERNAL_TOKEN_RANDOM_48

# --- Social / Facebook ---
SOCIAL_AUTO_QUOTA_ENFORCEMENT=1
SOCIAL_AUTO_FACEBOOK_MOCK=1
FACEBOOK_APP_ID=0000000000000000
FACEBOOK_APP_SECRET=CHANGE_ME_FACEBOOK_APP_SECRET
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8899/api/social/facebook/callback
CSKH_FB_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_VERIFY
CSKH_FB_REDIRECT_URI=http://127.0.0.1:8899/api/chatbot/facebook/callback

# --- Index / third-party ---
INDEXNOW_PLATFORM_KEY=
INDEX_CONTROL_SUBMIT_MONTHLY_DEFAULT=50
SINBYTE_API_KEY=CHANGE_ME_SINBYTE_API_KEY

# --- Object storage (R2 / S3) ---
WP_PLUGIN_STORAGE_BACKEND=r2
R2_BUCKET=example-bucket-name
R2_ENDPOINT_URL=https://xxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
R2_PREFIX=seoauto-dev/
R2_REGION=auto
R2_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
R2_FORCE_PATH_STYLE=false

# --- WordPress plugin CI ---
WP_PLUGIN_CI_RELEASE_TOKEN=CHANGE_ME_WP_PLUGIN_CI_RELEASE_TOKEN
WP_PLUGIN_RELEASE_SIGNING_KEY=CHANGE_ME_WP_PLUGIN_RELEASE_SIGNING_KEY
PLUGIN_CONTENT_OPS_CANARY_USER_IDS=
PLUGIN_PUBLISH_GUARD_CANARY_USER_IDS=
PLUGIN_AI_SEO_CANARY_USER_IDS=

# --- Playwright ---
PLAYWRIGHT_BROWSERS_PATH=
USE_PLAYWRIGHT=0
