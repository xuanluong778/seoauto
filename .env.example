# Copy to env.local (development) or set in production environment.
# Do not commit env.local or .env with real secrets.

# --- Core ---
APP_ENV=development
APP_BASE_URL=http://localhost:8899
DATABASE_URL=postgresql+psycopg2://user:password@127.0.0.1:5432/digiseo
JWT_SECRET=change-me

# --- SePay (bank transfer webhook) ---
# Required in production — webhooks are rejected (503) when both are empty.
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=

# --- Billing / bank transfer (public, shown on checkout) ---
BILLING_BANK_CODE=ACB
BILLING_BANK_ACCOUNT=7982468
BILLING_BANK_HOLDER=Cong ty TNHH The Gioi Digi
PAYMENT_ORDER_EXPIRE_MINUTES=60

# VAT on customer-facing prices and payment orders (percent, default 10)
BILLING_VAT_PERCENT=10

# Legacy aliases (optional; BILLING_* takes precedence)
# PAYMENT_BANK_CODE=ACB
# PAYMENT_BANK_ACCOUNT=7982468
# PAYMENT_BANK_HOLDER=Cong ty TNHH The Gioi Digi

# VietQR on checkout modal (1 = enabled)
PAYMENT_QR_ENABLED=1
