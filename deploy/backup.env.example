# SEOAuto backup configuration — copy to /etc/seoauto/backup.env on VPS
# chmod 600 /etc/seoauto/backup.env

APP_ROOT=/var/www/seoauto_vn_usr4940/data/www/seoauto.vn
BACKUP_LOCAL_DIR=/var/www/seoauto_vn_usr4940/backups/auto
BACKUP_LOG_FILE=/var/log/seoauto-backup.log
BACKUP_LOCK_FILE=/var/run/seoauto-backup.lock
BACKUP_ENV_FILE=/etc/seoauto/backup.env
BACKUP_KEY_FILE=/etc/seoauto/backup.key

DATABASE_URL=postgresql+psycopg2://backup_user:CHANGE_ME@127.0.0.1:5433/digiseo

RCLONE_REMOTE=gdrive
RCLONE_DEST=SEOAuto-Backups/prod

BACKUP_RETENTION_DAYS_LOCAL=7
BACKUP_RETENTION_DAYS_REMOTE=90
BACKUP_MIN_DISK_MB=2048
